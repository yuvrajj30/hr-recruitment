// ============================================================================
// HR Recruitment Management System - database design v2 (Prisma 7 / PostgreSQL)
// Multi-tenant (organizations), CafeOS-integration-ready (API only), internal
// and external candidates, passwordless candidate accounts.
//
// Standalone: no dependency on CafeOS and no connection to its database.
// Extra rules Prisma cannot express (partial unique indexes, value checks,
// append-only protection) live in prisma/extra-constraints.sql and are added
// to the first migration.
//
// Tenant isolation: every company-owned table carries organization_id. Child
// tables use composite foreign keys (organization_id, parent_id) so a row can
// never point at a parent that belongs to a different organization.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum CandidateType {
  EXTERNAL
  INTERNAL
}

enum JobVisibility {
  PUBLIC
  INTERNAL_ONLY
}

enum CandidateAccountStatus {
  ACTIVE
  DISABLED
}

enum LoginTokenPurpose {
  SIGN_IN
  VERIFY_EMAIL
}

enum EmployeeStatus {
  ACTIVE
  EXITED
}

enum EmploymentType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStage {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  SELECTED
  OFFER_ISSUED
  OFFER_ACCEPTED
  ONBOARDING
  JOINED
  REJECTED
  WITHDRAWN
  OFFER_DECLINED
}

enum DocumentKind {
  RESUME
  ADDITIONAL
  IDENTITY
  EDUCATION
  OFFER_LETTER
  OTHER
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormPurpose {
  INITIAL_APPLICATION
  TECHNICAL_SCREENING
  HR_SCREENING
  ADDITIONAL_INFORMATION
  INTERVIEW_EVALUATION
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  DROPDOWN
  RADIO
  CHECKBOXES
  DATE
  YES_NO
  FILE_UPLOAD
  RESUME_UPLOAD
  URL
  RATING
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  CANCELLED
  EXPIRED
}

enum InterviewType {
  ONLINE
  IN_PERSON
  PHONE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Recommendation {
  STRONGLY_RECOMMEND
  RECOMMEND
  HOLD
  REJECT
}

enum DecisionOutcome {
  SELECTED
  REJECTED
  ON_HOLD
}

enum OfferStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  JOINED
  CANCELLED
}

enum OnboardingDocStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS_CHANGED
  INTERVIEW_SCHEDULED
  INTERVIEW_RESCHEDULED
  INTERVIEW_CANCELLED
  INTERVIEW_REMINDER
  EVALUATION_PENDING
  FORM_ASSIGNED
  OFFER_ISSUED
  OFFER_RESPONDED
  ONBOARDING_DOCUMENTS_PENDING
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// --- Integration (CafeOS and any future system) ---

enum IntegrationSystem {
  CAFEOS
}

enum IntegrationConnectionStatus {
  NOT_CONFIGURED
  ACTIVE
  PAUSED
  ERROR
}

enum EmployeeLinkStatus {
  PENDING_MATCH
  LINKED
  CONFLICT
  UNLINKED
}

enum ExternalEntityType {
  DEPARTMENT
  LOCATION
  ROLE
  USER
}

enum SyncDirection {
  OUTBOUND
  INBOUND
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
