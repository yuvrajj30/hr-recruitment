# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.maintenance.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# AI/editor tooling and local helper files (not part of the app)
/.agents/
/.claude/
/.windsurf/
/.dist/
/skills-lock.json

# Local leftover draft of the Milestone 2 schema (identical copy of prisma/schema.prisma)
/prisma/schema.m2-proposed.prisma

# Private uploaded files (candidate resumes). Never committed, never served directly.
/storage/

# Personal documents and screenshots dropped in the project root (never part of the app)
/*.pdf
/*.png
