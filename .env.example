# Copy these names into your real .env file. NEVER put real values in this example file.
NODE_ENV=development
# Restricted account used by the running app:
DATABASE_URL=postgresql://hr_runtime:CHANGE_ME@localhost:5432/hr_recruitment
# Owner account used only for migrations and seeding:
MIGRATION_DATABASE_URL=postgresql://hr_app:CHANGE_ME@localhost:5432/hr_recruitment
DB_OWNER_ROLE=hr_app
# The scheduled job's account. Its connection NEVER goes in this file: see .env.maintenance.example.
DB_MAINTENANCE_ROLE=hr_maintenance
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_OF_32_OR_MORE_CHARS
APP_ORIGIN=http://localhost:3000
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
SESSION_TOUCH_INTERVAL_SECONDS=60
# 0 = no proxy in front (client IP headers are ignored). Set to the number of trusted proxies in production.
TRUSTED_PROXY_HOPS=0
CLIENT_IP_HEADER=x-forwarded-for
LOGIN_ATTEMPT_RETENTION_DAYS=14
SESSION_RETENTION_DAYS=30
