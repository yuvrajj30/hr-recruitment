# Settings of the scheduled housekeeping job ONLY (npm run privacy:retention). Copy to .env.maintenance.
# The web app never reads this file and refuses to start if MAINTENANCE_DATABASE_URL reaches it.
# NEVER put real values in this example file.
# The job's own account (create it once with prisma/sql/m4-01-create-maintenance-role.sql):
MAINTENANCE_DATABASE_URL=postgresql://hr_maintenance:CHANGE_ME@localhost:5432/hr_recruitment
